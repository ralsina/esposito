{
  "name": "Esposito OS",
  "version": "0.5.5",
  "home_assistant_domain": "esposito",
  "new_install_prompt_erase": false,
  "builds": [
    {
      "chipFamily": "ESP32",
      "parts": [
        { "path": "esp32/bootloader.bin", "offset": 4096 },
