        { "path": "esp32/firmware.bin", "offset": 65536 },
        { "path": "esp32/ota_data_initial.bin", "offset": 2162688 }
      ]
    },
    {
      "chipFamily": "ESP32-S3",
      "parts": [
        { "path": "esp32s3/bootloader.bin", "offset": 0 },
        { "path": "esp32s3/partition-table.bin", "offset": 32768 },
        { "path": "esp32s3/firmware.bin", "offset": 65536 },
        { "path": "esp32s3/ota_data_initial.bin", "offset": 2162688 }
      ]
    }
  ]
}
